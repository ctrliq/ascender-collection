{% if first_group | default(true) | bool %}
---
controller_groups:
{% endif %}
{% for group in current_groups_asset_value %}
  - name: {{ (group.name) | ctrliq.ascender.export_yaml }}
    description: {{ (template_overrides_resources.group[group.name].description
                     | default(template_overrides_global.group.description)
                     | default(group.description)) | ctrliq.ascender.export_yaml }}
    inventory: {{ (group.summary_fields.inventory.name) | ctrliq.ascender.export_yaml }}
{% if template_overrides_resources.group[group.name].variables is defined
      or template_overrides_global.group.variables is defined
      or (group.variables and group.variables != '---' and group.variables != '') %}
{% set __group_variables = template_overrides_resources.group[group.name].variables
         | default(template_overrides_global.group.variables)
         | default(group.variables) %}
    variables: {{ ((__group_variables if __group_variables is mapping or (__group_variables | type_debug) == 'list' else (__group_variables | from_yaml))) | ctrliq.ascender.export_yaml }}
{% endif %}
    children: {{ (query(controller_api_plugin, group.related.children, host=controller_hostname, oauth_token=controller_oauthtoken, verify_ssl=controller_validate_certs, return_all=true, max_objects=query_controller_api_max_objects ) | selectattr("name", "defined") | map(attribute="name")) | ctrliq.ascender.export_yaml }}
    hosts: {{ (query(controller_api_plugin, group.related.hosts, host=controller_hostname, oauth_token=controller_oauthtoken, verify_ssl=controller_validate_certs, return_all=true, max_objects=query_controller_api_max_objects ) | selectattr("name", "defined") | map(attribute="name")) | ctrliq.ascender.export_yaml }}
{% endfor %}
...
