{% if (current_credential_index | default(0)) == 0 %}
---
controller_credentials:
{% endif %}
  - name: {{ (current_credentials_asset_value.name) | ctrliq.ascender.export_yaml }}
    description: {{ (template_overrides_resources.credential[current_credentials_asset_value.name].description
                     | default(template_overrides_global.credential.description)
                     | default(current_credentials_asset_value.description)) | ctrliq.ascender.export_yaml }}
    credential_type: {{ (current_credentials_asset_value.summary_fields.credential_type.name) | ctrliq.ascender.export_yaml }}
{% if current_credentials_asset_value.organization is defined and current_credentials_asset_value.organization is not none %}
    organization: {{ (current_credentials_asset_value.summary_fields.organization.name) | ctrliq.ascender.export_yaml }}
{% else %}
    organization: {{ (organization) | ctrliq.ascender.export_yaml }}
{% endif %}
{% if template_overrides_resources.credential[current_credentials_asset_value.name].inputs is defined
      or (current_credentials_asset_value.inputs is defined and current_credentials_asset_value.inputs is not match('{}')) %}
{% if show_encrypted is defined and show_encrypted %}
    inputs: {{ (current_credentials_asset_value.inputs) | ctrliq.ascender.export_yaml }}
{% else %}
    inputs: {{ (template_overrides_resources.credential[current_credentials_asset_value.name].inputs | default(current_credentials_asset_value.inputs)
                | to_json | replace('"$encrypted$"', '""') | from_json) | ctrliq.ascender.export_yaml }}
{% endif %}
{% endif %}
{% if last_credential | default(true) | bool %}
...
{% endif %}
