{% if (current_notification_template_index | default(0)) == 0 %}
---
controller_notifications:
{% endif %}
  - name: {{ (current_notification_templates_asset_value.name) | ctrliq.ascender.export_yaml }}
    description: {{ (current_notification_templates_asset_value.description) | ctrliq.ascender.export_yaml }}
    organization: {{ (current_notification_templates_asset_value.summary_fields.organization.name) | ctrliq.ascender.export_yaml }}
    notification_type: {{ (current_notification_templates_asset_value.notification_type) | ctrliq.ascender.export_yaml }}
    notification_configuration:
{% for key,value in current_notification_templates_asset_value.notification_configuration.items() %}
{% if value is mapping or (value | type_debug == 'list') %}
      {{ (key) | ctrliq.ascender.export_yaml }}: {{ (value) | ctrliq.ascender.export_yaml }}
{% elif (value | type_debug == 'int') %}
      {{ (key) | ctrliq.ascender.export_yaml }}: {{ (value | int) | ctrliq.ascender.export_yaml }}
{% elif (value | lower) is match('true') or (value | lower) is match('false') %}
      {{ (key) | ctrliq.ascender.export_yaml }}: {{ (value | bool) | ctrliq.ascender.export_yaml }}
{% else %}
      {{ (key) | ctrliq.ascender.export_yaml }}: {{ (value) | ctrliq.ascender.export_yaml }}
{% endif %}
{% endfor %}
{% if current_notification_templates_asset_value.messages is defined and current_notification_templates_asset_value.messages %}
    messages: {{ (current_notification_templates_asset_value.messages) | ctrliq.ascender.export_yaml }}
{% endif %}
{% if last_notification_template | default(true) | bool %}
...
{% endif %}
