{%         if _var.first_survey_item %}
{%           set _var.first_survey_item = false %}
        - {{ current_content }}
{%         else %}
          {{ current_content }}
{%         endif %}
{%       endif %}
{%     endfor %}
{%   endfor %}
      description: {{ (spec_item.description) | ctrliq.ascender.export_yaml }}
{% endfor %}
