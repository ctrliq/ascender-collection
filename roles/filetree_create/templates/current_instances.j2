---
{% set __empty_values = [None, '', "None", [], {}, [{}]] %}
{# Only execution and hop nodes can be created through the API. Control and hybrid
   nodes are part of the installation, so exporting them produces code that cannot
   be applied. #}
{% set __exportable_node_types = ['execution', 'hop'] %}
{% set __exportable_node_states = ['installed', 'deprovisioning'] %}
{% set __exportable_instances = current_instances_asset_value | selectattr('node_type', 'defined') | selectattr('node_type', 'in', __exportable_node_types) | list %}
{% if __exportable_instances | length == 0 %}
controller_instances: []
{% else %}
controller_instances:
{% endif %}
{% for instance in __exportable_instances %}
  - hostname: {{ (instance.hostname) | ctrliq.ascender.export_yaml }}
{%   if instance.capacity_adjustment is defined and instance.capacity_adjustment not in __empty_values %}
    capacity_adjustment: {{ (instance.capacity_adjustment) | ctrliq.ascender.export_yaml }}
{%   endif %}
{%   if instance.enabled is defined %}
    enabled: {{ (instance.enabled | bool) | ctrliq.ascender.export_yaml }}
{%   endif %}
{%   if instance.managed_by_policy is defined %}
    managed_by_policy: {{ (instance.managed_by_policy | bool) | ctrliq.ascender.export_yaml }}
{%   endif %}
    node_type: {{ (instance.node_type) | ctrliq.ascender.export_yaml }}
{%   if instance.node_state is defined and instance.node_state not in __empty_values and instance.node_state in __exportable_node_states %}
    node_state: {{ (instance.node_state) | ctrliq.ascender.export_yaml }}
{%   endif %}
{%   if instance.listener_port is defined and instance.listener_port not in __empty_values %}
    listener_port: {{ (instance.listener_port) | ctrliq.ascender.export_yaml }}
{%   endif %}
{%   if instance.peers is defined and instance.peers | length > 0 %}
{#   The API returns peers as receptor address IDs. The instance module takes
     hostnames, so resolve each one or leave it as it came. #}
    peers:
{%     for peer in instance.peers %}
{%       set peer_id = peer | string %}
{%       set peer_hostname = __receptor_peer_hostname_by_id[peer_id]
                              | default(__instances_hostname_by_id[peer_id])
                              | default(peer) %}
      - {{ (peer_hostname) | ctrliq.ascender.export_yaml }}
{%     endfor %}
{%   endif %}
{%   if instance.peers_from_control_nodes is defined %}
    peers_from_control_nodes: {{ (instance.peers_from_control_nodes | bool) | ctrliq.ascender.export_yaml }}
{%   endif %}
{% endfor %}
