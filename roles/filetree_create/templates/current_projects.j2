{% if (current_project_index | default(0)) == 0 %}
---
controller_projects:
{% endif %}
  - name: {{ (current_projects_asset_value.name) | ctrliq.ascender.export_yaml }}
    description: {{ (template_overrides_resources.project[current_projects_asset_value.name].description
                     | default(template_overrides_global.project.description)
                     | default(current_projects_asset_value.description)) | ctrliq.ascender.export_yaml }}
    organization: {{ (current_projects_asset_value.summary_fields.organization.name
                      | default(organization if organization != 'ORGANIZATIONLESS'
                      else 'ToDo: The project \'' + current_projects_asset_value.name + '\' must have an organization')) | ctrliq.ascender.export_yaml }}
{% if template_overrides_resources.project[current_projects_asset_value.name].scm_type is defined
      or template_overrides_global.project.scm_type is defined
      or current_projects_asset_value.scm_type %}
    scm_type: {{ (template_overrides_resources.project[current_projects_asset_value.name].scm_type
                  | default(template_overrides_global.project.scm_type)
                  | default(current_projects_asset_value.scm_type)) | ctrliq.ascender.export_yaml }}
    scm_url: {{ (template_overrides_resources.project[current_projects_asset_value.name].scm_url
                 | default(template_overrides_global.project.scm_url)
                 | default(current_projects_asset_value.scm_url)) | ctrliq.ascender.export_yaml }}
    scm_track_submodules: {{ (template_overrides_resources.project[current_projects_asset_value.name].scm_track_submodules
                               | default(template_overrides_global.project.scm_track_submodules)
                               | default(current_projects_asset_value.scm_track_submodules | bool)) | ctrliq.ascender.export_yaml }}
{% if template_overrides_resources.project[current_projects_asset_value.name].signature_validation_credential is defined
      or template_overrides_global.project.signature_validation_credential is defined
      or current_projects_asset_value.summary_fields.signature_validation_credential is defined %}
    signature_validation_credential: {{ (template_overrides_resources.project[current_projects_asset_value.name].signature_validation_credential
                                           | default(template_overrides_global.project.signature_validation_credential)
                                           | default(current_projects_asset_value.summary_fields.signature_validation_credential.name)) | ctrliq.ascender.export_yaml }}
{% endif %}
{% if template_overrides_resources.project[current_projects_asset_value.name].scm_credential is defined
      or template_overrides_global.scm_credential is defined
      or current_projects_asset_value.summary_fields.credential is defined %}
    scm_credential: {{ (template_overrides_resources.project[current_projects_asset_value.name].scm_credential
                        | default(template_overrides_global.scm_credential)
                        | default(current_projects_asset_value.summary_fields.credential.name)) | ctrliq.ascender.export_yaml }}
{% endif %}
    scm_branch: {{ (template_overrides_resources.project[current_projects_asset_value.name].scm_branch
                    | default(template_overrides_global.project.scm_branch)
                    | default(current_projects_asset_value.scm_branch)) | ctrliq.ascender.export_yaml }}
    scm_clean: {{ (template_overrides_resources.project[current_projects_asset_value.name].scm_clean
                   | default(template_overrides_global.project.scm_clean)
                   | default(current_projects_asset_value.scm_clean)) | ctrliq.ascender.export_yaml }}
    scm_delete_on_update: {{ (template_overrides_resources.project[current_projects_asset_value.name].scm_delete_on_update
                              | default(template_overrides_global.project.scm_delete_on_update)
                              | default(current_projects_asset_value.scm_delete_on_update)) | ctrliq.ascender.export_yaml }}
    scm_update_on_launch: {{ (template_overrides_resources.project[current_projects_asset_value.name].scm_update_on_launch
                              | default(template_overrides_global.project.scm_update_on_launch)
                              | default(current_projects_asset_value.scm_update_on_launch)) | ctrliq.ascender.export_yaml }}
{% if template_overrides_resources.project[current_projects_asset_value.name].webhook_service is defined
      or template_overrides_global.project.webhook_service is defined
      or current_projects_asset_value.webhook_service %}
    webhook_service: {{ (template_overrides_resources.project[current_projects_asset_value.name].webhook_service
                         | default(template_overrides_global.project.webhook_service)
                         | default(current_projects_asset_value.webhook_service)) | ctrliq.ascender.export_yaml }}
{% endif %}
{% if template_overrides_resources.project[current_projects_asset_value.name].webhook_ref_filter is defined
      or template_overrides_global.project.webhook_ref_filter is defined
      or current_projects_asset_value.webhook_ref_filter %}
    webhook_ref_filter: {{ (template_overrides_resources.project[current_projects_asset_value.name].webhook_ref_filter
                            | default(template_overrides_global.project.webhook_ref_filter)
                            | default(current_projects_asset_value.webhook_ref_filter)) | ctrliq.ascender.export_yaml }}
{% endif %}
    scm_update_cache_timeout: {{ (template_overrides_resources.project[current_projects_asset_value.name].scm_update_cache_timeout
                                  | default(template_overrides_global.project.scm_update_cache_timeout)
                                  | default(current_projects_asset_value.scm_update_cache_timeout)) | ctrliq.ascender.export_yaml }}
    scm_refspec: {{ (template_overrides_resources.project[current_projects_asset_value.name].scm_refspec
                     | default(template_overrides_global.project.scm_refspec)
                     | default(current_projects_asset_value.scm_refspec)) | ctrliq.ascender.export_yaml }}
{% endif %}
{# local_path only means something for manual projects; for an SCM project the
   controller generates it, and exporting that generated value would pin the new
   project to a directory that belongs to the old one #}
{% if not current_projects_asset_value.scm_type and current_projects_asset_value.local_path %}
    local_path: {{ (template_overrides_resources.project[current_projects_asset_value.name].local_path
                      | default(template_overrides_global.project.local_path)
                      | default(current_projects_asset_value.local_path)) | ctrliq.ascender.export_yaml }}
{% endif %}
{% if is_controller_v4 and
      (template_overrides_resources.project[current_projects_asset_value.name].default_environment is defined
      or template_overrides_global.project.default_environment is defined
      or current_job_templates_asset_value.summary_fields.default_environment is defined) %}
    default_environment: {{ (template_overrides_resources.project[current_projects_asset_value.name].default_environment
                             | default(template_overrides_global.project.default_environment)
                             | default(current_job_templates_asset_value.summary_fields.default_environment.name)) | ctrliq.ascender.export_yaml }}
{% endif %}
    allow_override: {{ (template_overrides_resources.project[current_projects_asset_value.name].allow_override
                        | default(template_overrides_global.project.allow_override)
                        | default(current_projects_asset_value.allow_override)) | ctrliq.ascender.export_yaml }}
    update_project: {{ (template_overrides_resources.project[current_projects_asset_value.name].update_project
                        | default(template_overrides_global.project.update_project)
                        | default(update_project_state | default(false))) | ctrliq.ascender.export_yaml }}
    timeout: {{ (template_overrides_resources.project[current_projects_asset_value.name].timeout
                 | default(template_overrides_global.project.timeout)
                 | default(current_projects_asset_value.timeout)) | ctrliq.ascender.export_yaml }}
{% if query_notification_error | length > 0 %}
    notification_templates_error:
{% for notification_error in query_notification_error %}
      - {{ (notification_error.name) | ctrliq.ascender.export_yaml }}
{% endfor %}
{% endif %}
{% if query_notification_started | length > 0 %}
    notification_templates_started:
{% for notification_started in query_notification_started %}
      - {{ (notification_started.name) | ctrliq.ascender.export_yaml }}
{% endfor %}
{% endif %}
{% if query_notification_success | length > 0 %}
    notification_templates_success:
{% for notification_success in query_notification_success %}
      - {{ (notification_success.name) | ctrliq.ascender.export_yaml }}
{% endfor %}
{% endif %}
{% if last_project | default(true) | bool %}
...
{% endif %}
