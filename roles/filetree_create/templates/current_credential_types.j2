---
controller_credential_types:
{% for credential_type in current_credential_types_asset_value %}
  - name: {{ (credential_type.name) | ctrliq.ascender.export_yaml }}
    description: {{ (template_overrides_resources.credential_type[credential_type.name].description
                     | default(template_overrides_global.credential_type.description)
                     | default(credential_type.description)) | ctrliq.ascender.export_yaml }}
    kind: {{ (credential_type.kind) | ctrliq.ascender.export_yaml }}
    inputs: {{ (template_overrides_resources.credential_type[credential_type.name].inputs | default(credential_type.inputs)) | ctrliq.ascender.export_yaml }}
{% if template_overrides_resources.credential_type[credential_type.name].injectors is defined
      or (credential_type.injectors and credential_type.injectors != '---') %}
    injectors: {{ (template_overrides_resources.credential_type[credential_type.name].injectors | default(credential_type.injectors)) | ctrliq.ascender.export_yaml }}
{% endif %}
{% endfor %}
...
